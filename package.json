{
  "name": "threadweaver",
  "version": "0.1.0",
  "description": "File Grok, ChatGPT, and Claude threads into one living card. Ask any model — the answer comes from the current card only.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "threadweaver": "dist/index.js"
  },
  "files": [
    "dist",
    "seed",
    "prompts"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint:md": "markdownlint-cli2 \"**/*.md\""
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "markdownlint-cli2": "^0.18.1",
    "tsx": "^4.0.0",
    "typescript": "^5.9.0",
    "vitest": "4.0.18"
  }
}
